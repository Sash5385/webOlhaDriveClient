{
    "hosting":  {
                    "site":  "olhadrive-app",
                    "public":  "dist",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "rewrites":  [
                                     { "source": "/api/report-error", "function": "reportError", "region": "europe-west1" },
{
                                         "source":  "**",
                                         "destination":  "/index.html"
                                     }
                                 ]
                }
}
